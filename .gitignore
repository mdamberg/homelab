# Environment files (secrets — never commit; .env.example templates are allowed)
.env
**/.env
*.env.local
**/*.env.local

# Migration backup artifacts
*.before-migration/
**/*.before-migration/

# Runtime data
docker/docker-projects/work_todo/data/

# dbt backups
dbt/backups/

# TLS certificates (Pi-hole)
docker/docker-projects/pie_hole/etc-pihole/tls.crt
docker/docker-projects/pie_hole/etc-pihole/tls.pem
docker/docker-projects/pie_hole/etc-pihole/tls_ca.crt
docker/docker-projects/pie_hole/etc-pihole/migration_backup/

# n8n: config holds the credential encryption key; workflow exports embed API keys
docker/docker-projects/n8n/n8n_data/config
docker/docker-projects/n8n/n8n_data/*backup*.json

# Claude Code per-machine settings (allowlisted commands can embed tokens)
**/.claude/settings.local.json

# Caddy runtime state (ACME account key, certificate private keys, autosaved config)
docker/docker-projects/reverse_proxy/data/
docker/docker-projects/reverse_proxy/config/
