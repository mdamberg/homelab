# PostgreSQL Configuration
POSTGRES_DB=home_metrics
POSTGRES_USER=metrics_user
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_PORT=5432

# Timezone
TZ=America/Chicago

# Healthchecks.io ping URLs — alerts on failure and missed runs
# Create three checks at healthchecks.io and paste the ping URLs below.
# The dbt-runner container runs in UTC, so all three checks must be Cron-type
# checks with Server's Time Zone = UTC (a timezone mismatch here causes
# checks to flap DOWN/UP even when dbt is running fine).
# Regular check: cron "0 6-22/2 * * *" UTC, grace=10min — pings on dbt run/test outcome
# Refresh check: cron "0 0 * * *" UTC, grace=10min — pings on dbt run/test outcome
# Freshness check: cron "0 0,6-22/2 * * *" UTC, grace=10min — pings on dbt
#   source freshness outcome, separate from run/test so a stale source
#   doesn't get conflated with a broken build
HC_DBT_REGULAR=https://hc-ping.com/YOUR-UUID-HERE
HC_DBT_REFRESH=https://hc-ping.com/YOUR-UUID-HERE
HC_DBT_FRESHNESS=https://hc-ping.com/YOUR-UUID-HERE
