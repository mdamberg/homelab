# =============================================================================
# Master secrets file — copy to .env and fill in real values
# Run setup-env.ps1 to deploy these to all service folders
# NEVER commit .env (it is gitignored)
# =============================================================================

# --- Shared ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Media Stack (Gluetun/PIA VPN) ---
OPENVPN_USER=your_pia_username
OPENVPN_PASSWORD=your_pia_password
HOMARR_SECRET_KEY=your_homarr_secret_key

# --- Backups (Duplicati) ---
DUPLICATI_WEBPASS=your_duplicati_password
HEALTHCHECKS_URL=your_healthchecks_ping_url
SETTINGS_ENCRYPTION_KEY=your_duplicati_encryption_key

# --- Lightdash ---
LIGHTDASH_PG_USER=lightdash_user
LIGHTDASH_PG_PASSWORD=your_lightdash_pg_password
LIGHTDASH_SECRET=your_lightdash_secret
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_minio_password
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# --- Linkding ---
LD_SUPERUSER_NAME=admin
LD_SUPERUSER_PASSWORD=your_linkding_password

# --- phpIPAM ---
IPAM_DATABASE_NAME=phpipam
MYSQL_USER=phpipam
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# --- n8n ---
TELLER_APPLICATION_ID=your_teller_app_id
TELLER_CERTS_HOST_PATH=C:/path/to/teller/certs
TELLER_TOKENS=your_teller_tokens

# --- MCP Server ---
N8N_API_KEY=your_n8n_api_key
N8N_API_URL=http://n8n:5678

# --- Weather ---
WEATHER_API_KEY=your_weather_api_key
